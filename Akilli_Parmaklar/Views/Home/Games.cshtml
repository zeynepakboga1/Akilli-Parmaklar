
@{
    ViewData["Title"] = "Oyunlar";

}

<h1> Oyunlar sayfamiza hosgeldinz</h1>
<table>
    <thead>
        <tr>
            <th>Oyun adı</th>
            <th>Oyun açıklaması</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var game in ViewBag.Games)
        {
            <tr>
                <td>@game.Name</td>
                <td>@game.Description</td>
            </tr>
        }
    </tbody>
</table>
